{
  "name": "msl-dimensionering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write src/engine/*.ts tests/*.ts",
    "format:check": "prettier --check src/engine/*.ts tests/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:reports": "node --test spikes/report-typescript/compile.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
