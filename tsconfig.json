{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/engine/**/*.ts",
    "tests/**/*.ts",
    "spikes/report-typescript/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "tests/browser/**/*.ts"
  ]
}
